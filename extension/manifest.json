{
  "manifest_version": 3,
  "name": "Verique - Fact-check any page",
  "short_name": "Verique",
  "description": "Check the factual claims on any web page, or in text you select, against independent sources.",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Verique",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "verify-page": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Fact-check the current page"
    },
    "verify-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Fact-check the selected text"
    }
  }
}
