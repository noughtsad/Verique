# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Only the settings relevant to the LLM / search / Jev setup are listed here;
# see app/core/config.py for everything else.

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Auth ---
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# --- LLM (Groq) ---
GROQ_API_KEY=

# --- Web search (Tavily is used first when set, DuckDuckGo is the fallback) ---
TAVILY_API_KEY=

# --- Claim classifier ---
# Upstream Groq classifier that drops opinions / personal reflections before verification.
ENABLE_CLAIM_CLASSIFIER=true

# --- Jev decision model (see "Jev decision model" in the repo CLAUDE.md) ---
# Master switch. false = no Jev calls at all.
JEV_ENABLED=false
# true  = shadow: Groq decides, Jev's answers are only logged to JEV_SHADOW_LOG_PATH.
# false = live: Jev decides claims it is confident about, Groq decides the rest.
JEV_SHADOW_MODE=true
# Live mode: Jev decides when P(verifiable) >= this or <= 1 - this.
JEV_CONFIDENCE=0.8

# Provider A (current): OpenCode Zen free Jev. No API key needed. Limited-time offer,
# free-tier prompts may be logged/used for training, rate limits unknown.
AI_GATEWAY_BASE_URL=https://opencode.ai/zen
JEV_MODEL=jev-1.13-free

# Provider B: Vercel AI Gateway (paid credits needed for typesafe-ai/jev; a card on file
# is required even for free models). Uncomment both and set the key.
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# JEV_MODEL=typesafe-ai/jev
# AI_GATEWAY_API_KEY=            # sent ONLY to *.vercel.sh hosts, never to OpenCode

# Optional key for any other Jev provider that needs one.
# JEV_API_KEY=

# JSONL log of Groq-vs-Jev comparisons (shadow mode). logs/ is gitignored.
# JEV_SHADOW_LOG_PATH=logs/jev_shadow.jsonl
